# Copy to .env and fill in. Never commit .env.

# ── GitHub ──────────────────────────────────────────────────
# Fine-grained token with "Pull requests: Read and write" + "Contents: Read".
# Leave empty for a DRY RUN (review is logged, not posted; 60 req/hour API limit).
GITHUB_TOKEN=

# ── LLM provider ────────────────────────────────────────────
# 'groq' (default) or 'gemini'
LLM_PROVIDER=groq
GROQ_API_KEY=
# GOOGLE_API_KEY=
# Optional model override (defaults: llama-3.3-70b-versatile / gemini-2.5-flash)
# LLM_MODEL=

# ── Safety ──────────────────────────────────────────────────
# ESLint and go vet/staticcheck EXECUTE code from the reviewed repository.
# Only enable for repositories you trust. Ruff and Semgrep always run.
PRPILOT_TRUST_REPO_CODE=false

# ── Optional: LangSmith tracing ─────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=prpilot
